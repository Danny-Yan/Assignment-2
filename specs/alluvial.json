{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": null,
  "title": {
    "text": "Net area that changed land use, 2010–11 to 2020–21",
    "subtitle": "Band width = area"
  },
  "width": 600,
  "height": 380,
  "layer": [
    {
      "data": {
        "url": "data/alluvial_links.csv"
      },
      "mark": {
        "type": "area",
        "orient": "vertical",
        "opacity": 0.55,
        "interpolate": "linear",
        "line": false
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              600
            ]
          }
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              375,
              -10
            ]
          }
        },
        "y2": {
          "field": "y2"
        },
        "detail": {
          "field": "flow",
          "type": "nominal"
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grazing native vegetation",
              "Grazing pastures",
              "Cropping",
              "Horticulture",
              "Conservation and protected areas",
              "Other minimal use",
              "Forests",
              "Urban and other",
              "Water"
            ],
            "range": [
              "#C291B0",
              "#9a6f8a",
              "#D6F49B",
              "#DC2864",
              "#39A2EE",
              "#2b6fa0",
              "#4f8a5b",
              "#8f9a7a",
              "#5d6153"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "source",
            "title": "From"
          },
          {
            "field": "target",
            "title": "To"
          },
          {
            "field": "area_mha",
            "title": "Million ha"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/alluvial_links.csv"
      },
      "transform": [
        {
          "fold": [
            "y",
            "y2"
          ],
          "as": [
            "edge",
            "pos"
          ]
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 1,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "pos",
          "type": "quantitative"
        },
        "detail": [
          {
            "field": "flow",
            "type": "nominal"
          },
          {
            "field": "edge",
            "type": "nominal"
          }
        ],
        "color": {
          "field": "source",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grazing native vegetation",
              "Grazing pastures",
              "Cropping",
              "Horticulture",
              "Conservation and protected areas",
              "Other minimal use",
              "Forests",
              "Urban and other",
              "Water"
            ],
            "range": [
              "#C291B0",
              "#9a6f8a",
              "#D6F49B",
              "#DC2864",
              "#39A2EE",
              "#2b6fa0",
              "#4f8a5b",
              "#8f9a7a",
              "#5d6153"
            ]
          },
          "legend": null
        },
        "order": {
          "field": "order",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "url": "data/alluvial_nodes.csv"
      },
      "mark": "rect",
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "y",
          "type": "quantitative"
        },
        "y2": {
          "field": "y2"
        },
        "color": {
          "field": "group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Grazing native vegetation",
              "Grazing pastures",
              "Cropping",
              "Horticulture",
              "Conservation and protected areas",
              "Other minimal use",
              "Forests",
              "Urban and other",
              "Water"
            ],
            "range": [
              "#C291B0",
              "#9a6f8a",
              "#D6F49B",
              "#DC2864",
              "#39A2EE",
              "#2b6fa0",
              "#4f8a5b",
              "#8f9a7a",
              "#5d6153"
            ]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "url": "data/alluvial_nodes.csv"
      },
      "transform": [
        {
          "filter": "datum.side == 'from'"
        },
        {
          "calculate": "split(datum.wrapped,'|')",
          "as": "lines"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "fontSize": 11,
        "color": "#e9eddf",
        "lineHeight": 13,
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "lines"
        }
      }
    },
    {
      "data": {
        "url": "data/alluvial_nodes.csv"
      },
      "transform": [
        {
          "filter": "datum.side == 'to'"
        },
        {
          "calculate": "split(datum.wrapped,'|')",
          "as": "lines"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 20,
        "fontSize": 11,
        "color": "#e9eddf",
        "lineHeight": 13,
        "baseline": "middle"
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },
        "y": {
          "field": "cy",
          "type": "quantitative"
        },
        "text": {
          "field": "lines"
        }
      }
    }
  ],
  "config": {
    "axis": {
      "labelColor": "#e9eddf",
      "titleColor": "#e9eddf",
      "gridColor": "#3f4238",
      "domainColor": "#55584d",
      "tickColor": "#55584d"
    },
    "legend": {
      "labelColor": "#e9eddf",
      "titleColor": "#e9eddf",
      "orient": "bottom",
      "gradientLength": 220,
      "padding": 4
    },
    "title": {
      "color": "#e9eddf",
      "font": "Fraunces",
      "fontSize": 15,
      "anchor": "start",
      "subtitleColor": "#C291B0",
      "subtitleFont": "Work Sans",
      "subtitleFontSize": 12,
      "subtitlePadding": 4
    },
    "view": {
      "stroke": null
    }
  }
}